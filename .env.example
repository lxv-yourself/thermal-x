# Thermal-X Environment Variables
# Copy this to .env.local and fill in values

# NASA FIRMS API Key
# Get from: https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_API_KEY=

# Database path (defaults to ./thermal-x.db)
DATABASE_PATH=./thermal-x.db

# Demo mode - set to true to always use demo data
DEMO_MODE=false

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Open-Meteo is free, no key needed
# Overpass API is free, no key needed
# OpenStreetMap tiles are free, no key needed
